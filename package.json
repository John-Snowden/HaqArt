{
  "name": "legalart",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:userbook": "pm2 start 'yarn start' --name userbook --cwd ./userbook",
    "start:haq_portal": "pm2 start 'yarn start' --name haq_portal --cwd ./haq_portal",
    "start:all": "yarn start:userbook && yarn start:haq_portal",
    "stop:all": "pm2 stop all && pm2 delete all && pm2 save --force && pm2 unstartup",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "pr_reset": "npx prisma migrate reset --schema ./shared_packages/prisma/schema.prisma",
    "pr_dev": "prisma migrate dev --name init --schema ./shared_packages/prisma/schema.prisma",
    "pr_prod": "prisma generate --schema ./shared_packages/prisma/schema.prisma && prisma migrate deploy --schema ./shared_packages/prisma/schema.prisma",
    "pr_format": "prisma format --schema ./shared_packages/prisma/schema.prisma"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.9.2",
    "prisma": "^6.18.0"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "date-fns": "^4.1.0"
  }
}
