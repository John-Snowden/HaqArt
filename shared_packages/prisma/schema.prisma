generator client {
  provider      = "prisma-client-js"
  output        = "./prisma/client"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  username String @unique
  password String
  roles    ROLE[]

  authoredBloggers Blogger[]
  authoredOrigins  Origin[]
  authoredPersons  Person[]
  authoredCases    Case[]        @relation("authoredCases")
  managedCases     Case[]        @relation("managedCases")
  authoredOpponents         Opponent[]
  authoredCalls             Call[]
  authoredAppointments      Appointment[]
}

model Person {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  name        String
  phoneNumber String? @unique
  link        String? @unique
  email       String? @unique
  homeAddress String?

  authorId Int
  originId Int

  leadStatus LEAD_STATUS @default(ADDED_TO_DB)

  author      Employee      @relation(fields: [authorId], references: [id])
  origin      Origin        @relation(fields: [originId], references: [id])
  cases       Case[]
  calls        Call[]
  appointments Appointment[]
}

model Case {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  caseImportance IMPORTANCE      @default(TWO)
  caseUrgency    URGENCY         @default(THREE)
  caseStatus     CASE_STATUS     @default(UNASSIGNED)
  categories     CASE_CATEGORY[]

  problemShort        String?
  problemFull         String?
  nearestTask         String?
  courtInfo           String?
  nearestTaskDeadline DateTime?
  timeOfPerformance   DateTime?
  assignmentTime      DateTime?

  refusalReason REFUSAL_REASON?
  legalAction   LEGAL_ACTION?
  statusInCourt STATUS_IN_COURT?
  priceSOM      BigInt?
  priceUSD      BigInt?

  personId   Int
  authorId   Int
  opponentId Int?
  managerId  Int?

  author       Employee      @relation("authoredCases", fields: [authorId], references: [id])
  manager      Employee?     @relation("managedCases", fields: [managerId], references: [id])
  opponent     Opponent?     @relation(fields: [opponentId], references: [id])
  person       Person        @relation(fields: [personId], references: [id])
  appointments Appointment[]
  calls        Call[]
}

model Origin {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  title      String          @unique
  link       String?         @unique
  categories CASE_CATEGORY[]

  authorId Int

  author  Employee @relation(fields: [authorId], references: [id])
  persons Person[]
}

model Opponent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  name String  @unique
  link String? @unique
  info String?

  authorId Int

  cases  Case[]
  author Employee @relation(fields: [authorId], references: [id])
}

model Blogger {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  name             String  @unique
  link             String  @unique
  phoneNumber      String? @unique
  email            String? @unique
  info             String?
  subscribersCount BigInt

  priceSOM BigInt?
  priceUSD BigInt?

  authorId Int

  categories CASE_CATEGORY[]
  author     Employee        @relation(fields: [authorId], references: [id])
}

model Call {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  callStatus CALL_STATUS
  info       String?
  redialDate DateTime?

  caseId   Int
  personId Int
  authorId Int

  case   Case     @relation(fields: [caseId], references: [id])
  author Employee @relation(fields: [authorId], references: [id])
  person Person   @relation(fields: [personId], references: [id])
}

model Appointment {
  id       Int      @id @default(autoincrement())
  createAt DateTime @default(now())

  date              DateTime
  appointmentStatus APPOINTMENT_STATUS

  caseId   Int
  personId Int
  authorId Int

  person Person   @relation(fields: [personId], references: [id])
  author Employee @relation(fields: [authorId], references: [id])
  case   Case     @relation(fields: [caseId], references: [id])
}

enum APPOINTMENT_STATUS {
  DONE
  MISSED
}

enum CALL_STATUS {
  DONE
  MISSED
}

enum LEAD_STATUS {
  ADDED_TO_DB
  CONTACT_SHARED
  CLIENT
  RETURNING_CLIENT
}

enum CASE_STATUS {
  UNASSIGNED
  PENDING_START
  IN_PROGRESS
  BLOCKED
  PENDING_CHECK
  DONE
  WE_REFUSED
  PERSON_REFUSED
}

enum URGENCY {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum IMPORTANCE {
  ONE
  TWO
  THREE
}

enum ROLE {
  DEV
  OWNER
  CEO
  SMM_MANAGER
  SALES_MANAGER
  ACCOUNT_MANAGER
  LAWYER
  BOT
}

enum LEGAL_ACTION {
  CONSULTATION
  FILING
  COURT_PARTICIPATION
  APPOINTMENT
  NEGOTIATIONS
  CLAIM
  LAWYER_REQUEST
}

enum STATUS_IN_COURT {
  POSTPONED
  PAUSED
  JUDGE_ON_VACATION
  REASSIGNED
  NEGOTIATIONS
  RETURNED
}

enum REFUSAL_REASON {
  CHOSE_COMPETITOR
  IRRELEVANT_SERVICES
  TOO_EXPENSIVE
}

enum CASE_CATEGORY {
  REAL_ESTATE
  FOREIGNERS
  CARS
  LOANS
  OTHER
}
